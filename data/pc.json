        { "id": "office", "label": "Office・レポート",  "conditions": { "memory_min": 16, "memory_rec": 16 } },
        { "id": "univ",   "label": "大学で使う",        "conditions": { "memory_min": 16, "memory_rec": 16 } },
        { "id": "video",  "label": "動画編集",          "conditions": { "memory_min": 16, "memory_rec": 32 } },
