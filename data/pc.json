        { "id": "note",    "label": "ノート（あまり持ち運びは考えていない）", "conditions": { "form_factor": "standard" } },
        { "id": "desktop", "label": "デスクトップ（モニター一体型）",        "conditions": { "form_factor": "desktop" } }
      ]
    },
    {
      "id": "maker",
      "label": "使っていた・欲しいメーカー",
      "multiple": true,
      "options": [
        { "id": "fmv",      "label": "FMV",      "conditions": { "maker": "FMV" } },
        { "id": "nec",      "label": "NEC",      "conditions": { "maker": "NEC" } },
        { "id": "dynabook", "label": "dynabook", "conditions": { "maker": "dynabook" } },
        { "id": "dell",     "label": "DELL",     "conditions": { "maker": "DELL" } },
        { "id": "lenovo",   "label": "Lenovo",   "conditions": { "maker": "Lenovo" } },
        { "id": "vaio",     "label": "VAIO",     "conditions": { "maker": "VAIO" } },
        { "id": "any",      "label": "こだわらない", "conditions": {} }
